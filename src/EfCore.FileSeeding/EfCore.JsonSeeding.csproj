<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EfCore.JsonSeeding</RootNamespace>
    <Description>Заполнение базы данных EF Core из JSON-файлов: один файл на таблицу, порядок загрузки по внешним ключам, повторный запуск безопасен.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EfCore.JsonSeeding.Tests" />
  </ItemGroup>

</Project>
